      "regex": "^(?!/_next)/ebooks(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    },
    {
      "source": "/ebooks",
      "destination": "/books",
      "statusCode": 308,
      "regex": "^(?!/_next)/ebooks(?:/)?$"
    },
    {
      "source": "/ebooks/",
      "destination": "/books",
      "statusCode": 308,
      "regex": "^(?!/_next)/ebooks/(?:/)?$"
    }
