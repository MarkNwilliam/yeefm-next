14:{"metadata":[["$","title","0",{"children":"Yee FM Ebooks Audiobooks and Research papers with An Ai Virtual teacher"}],["$","meta","1",{"name":"description","content":"Yee FM is a cutting-edge multilingual ebook and audiobook streaming platform that offers AI-powered chat assistance, seamless text-to-speech synthesis, and an extensive library of ebooks. Perfect for avid readers and learners, Yee FM supports multiple languages, including French, Spanish, Swahili, and Arabic. Enjoy personalized reading experiences and effortless audiobook streaming. The website is also an online radio directory with more than 2000 radio stations!"}],["$","meta","2",{"name":"author","content":"Yee FM"}],["$","link","3",{"rel":"manifest","href":"/manifest.json","crossOrigin":"$undefined"}],["$","meta","4",{"name":"keywords","content":"ebooks, audiobooks, research papers, virtual teacher, ai, chatbot, text-to-speech, multilingual, radio stations, online radio, streaming platform, reading, learning, languages, French, Spanish, Swahili, Arabic, personalized, experiences, radio directory, 2000 radio stations"}],["$","meta","5",{"name":"robots","content":"index, follow"}],["$","meta","6",{"name":"theme-color","content":"#000000"}],["$","meta","7",{"name":"google-adsense-account","content":"ca-pub-7163440324211024"}],["$","meta","8",{"name":"yandex-verification","content":"c03b962c1dc2328c1"}],["$","meta","9",{"property":"og:title","content":"Yee FM Ebooks Audiobooks and Research papers with An Ai Virtual teacher"}],["$","meta","10",{"property":"og:description","content":"Yee FM is a cutting-edge multilingual ebook and audiobook streaming platform that offers AI-powered chat assistance, seamless text-to-speech synthesis, and an extensive library of ebooks."}],["$","meta","11",{"property":"og:url","content":"https://www.yeefm.com"}],["$","meta","12",{"property":"og:site_name","content":"Yee FM"}],["$","meta","13",{"property":"og:image","content":"https://www.yeefm.com/favicon_io/android-chro